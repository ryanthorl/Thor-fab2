import { createFileRoute } from "@tanstack/react-router";
import { useState } from "react";

export const Route = createFileRoute("/contact")({
  head: () => ({
    meta: [
      { title: "Contact | Thor Fabrication — Request a Quote" },
      { name: "description", content: "Get a quote for custom CNC plasma cutting, metal fabrication, or powder coating. Send your file, sketch, or project details." },
      { property: "og:title", content: "Contact | Thor Fabrication" },
      { property: "og:description", content: "Request a quote for custom metalwork — fast, honest pricing." },
    ],
  }),
  component: Contact,
});

function Contact() {
  const [submitted, setSubmitted] = useState(false);
  const [form, setForm] = useState({ name: "", email: "", phone: "", service: "", message: "" });

  const onSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    const subject = encodeURIComponent(`Quote request — ${form.service || "Project"}`);
    const body = encodeURIComponent(
      `Name: ${form.name}\nEmail: ${form.email}\nPhone: ${form.phone}\nService: ${form.service}\n\nProject details:\n${form.message}`
    );
    window.location.href = `mailto:hello@thor-fab.com?subject=${subject}&body=${body}`;
    setSubmitted(true);
  };

  return (
    <>
      <section className="pt-40 pb-16 px-6 relative">
        <div className="absolute inset-0 bg-grid opacity-[0.1]" />
        <div className="mx-auto max-w-7xl relative">
          <div className="font-display text-xs tracking-[0.3em] text-primary mb-4">/ CONTACT</div>
          <h1 className="font-display text-6xl md:text-8xl text-foreground leading-[0.95] max-w-4xl">
            Start a <span className="text-primary">quote.</span>
          </h1>
          <p className="mt-8 text-lg text-muted-foreground max-w-2xl">
            Tell us about your project. Files, sketches, photos — all welcome. We'll get back to you with pricing and a realistic lead time.
          </p>
        </div>
      </section>

      <section className="px-6 pb-24">
        <div className="mx-auto max-w-7xl grid lg:grid-cols-5 gap-10">
          {/* FORM */}
          <div className="lg:col-span-3 bg-card border border-border p-8 md:p-12 cut-corner">
            {submitted ? (
              <div className="py-16 text-center">
                <div className="inline-flex h-16 w-16 items-center justify-center bg-primary text-primary-foreground text-3xl mb-6">✓</div>
                <h2 className="font-display text-3xl text-foreground">Email opened.</h2>
                <p className="text-muted-foreground mt-3">If your mail client didn't pop up, send your details directly to <a className="text-primary underline" href="mailto:hello@thor-fab.com">hello@thor-fab.com</a>.</p>
              </div>
            ) : (
              <form onSubmit={onSubmit} className="space-y-6">
                <div className="grid sm:grid-cols-2 gap-6">
                  <Field label="Name" required>
                    <input required value={form.name} onChange={(e) => setForm({ ...form, name: e.target.value })} className={inputCls} />
                  </Field>
                  <Field label="Email" required>
                    <input required type="email" value={form.email} onChange={(e) => setForm({ ...form, email: e.target.value })} className={inputCls} />
                  </Field>
                </div>
                <div className="grid sm:grid-cols-2 gap-6">
                  <Field label="Phone">
                    <input type="tel" value={form.phone} onChange={(e) => setForm({ ...form, phone: e.target.value })} className={inputCls} />
                  </Field>
                  <Field label="Service" required>
                    <select required value={form.service} onChange={(e) => setForm({ ...form, service: e.target.value })} className={inputCls}>
                      <option value="">Select…</option>
                      <option>CNC Plasma Cutting</option>
                      <option>Custom Fabrication</option>
                      <option>Powder Coating</option>
                      <option>Full Build (Cut + Fab + Coat)</option>
                      <option>Other / Not Sure</option>
                    </select>
                  </Field>
                </div>
                <Field label="Project details" required>
                  <textarea required rows={6} value={form.message} onChange={(e) => setForm({ ...form, message: e.target.value })} placeholder="Describe the piece, dimensions, materials, finish color, deadline…" className={inputCls} />
                </Field>
                <button type="submit" className="w-full bg-primary px-8 py-4 font-display tracking-widest text-primary-foreground hover:brightness-110 transition cut-corner">
                  Send Quote Request →
                </button>
              </form>
            )}
          </div>

          {/* INFO */}
          <div className="lg:col-span-2 space-y-6">
            <InfoCard title="Email" lines={["hello@thor-fab.com"]} link="mailto:hello@thor-fab.com" />
            <InfoCard title="Shop Hours" lines={["Mon — Fri · 8a — 5p", "Saturday by appointment"]} />
            <InfoCard title="Service Area" lines={["Local pickup & delivery", "Installation available"]} />
            <div className="bg-gradient-to-br from-primary to-primary/70 p-8 cut-corner">
              <h3 className="font-display text-xl text-primary-foreground mb-3">Have a DXF/DWG?</h3>
              <p className="text-primary-foreground/90 text-sm">Send it along with your project details and we'll cost the cut in your reply.</p>
            </div>
          </div>
        </div>
      </section>
    </>
  );
}

const inputCls = "w-full bg-background border border-border px-4 py-3 text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition";

function Field({ label, required, children }: { label: string; required?: boolean; children: React.ReactNode }) {
  return (
    <label className="block">
      <span className="font-display text-xs tracking-widest text-muted-foreground block mb-2">{label}{required && <span className="text-primary"> *</span>}</span>
      {children}
    </label>
  );
}

function InfoCard({ title, lines, link }: { title: string; lines: string[]; link?: string }) {
  const inner = (
    <>
      <div className="font-display text-xs tracking-[0.2em] text-primary mb-3">{title}</div>
      {lines.map((l) => <div key={l} className="text-foreground">{l}</div>)}
    </>
  );
  return link ? (
    <a href={link} className="block bg-card border border-border p-6 hover:border-primary transition cut-corner">{inner}</a>
  ) : (
    <div className="bg-card border border-border p-6 cut-corner">{inner}</div>
  );
}
